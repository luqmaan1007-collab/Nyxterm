#!/data/data/com.termux/files/usr/bin/bash
# =============================================
# NyxTerm shell — with live progress for installs
# =============================================

PREFIX="$HOME/.nyxterm"
BIN="$PREFIX/bin"
mkdir -p "$BIN"

# ----------------------
# Helper functions
# ----------------------
install_command() {
    pkgname="$1"
    echo "[*] Installing $pkgname via Termux (with progress)..."

    if ! command -v apt >/dev/null 2>&1; then
        echo "[✗] apt not found! Cannot install packages."
        return 1
    fi

    # Update package lists
    echo "[*] Updating package lists..."
    apt-get update -o Dpkg::Progress-Fancy=1

    # Install package with fancy progress
    apt-get install "$pkgname" -o Dpkg::Progress-Fancy=1
    if [ $? -eq 0 ]; then
        echo "[✓] $pkgname installed successfully!"
    else
        echo "[✗] Failed to install $pkgname"
    fi
}

install_script() {
    # For custom scripts from CDN
    scriptname="$1"
    url="$2"
    dest="$BIN/$scriptname"

    echo "[*] Downloading $scriptname from $url"
    curl -L --progress-bar "$url" -o "$dest"
    chmod +x "$dest"
    echo "[✓] $scriptname installed at $dest"
}

builtin_help() {
    echo "NyxTerm commands:"
    echo "  nyx install <package>         - Install Termux package with progress"
    echo "  nyx install-script <name> <url> - Install custom script from URL"
    echo "  help                          - Show this help"
    echo "  exit                          - Exit shell"
}

# ----------------------
# Main shell loop
# ----------------------
echo "NyxTerm shell — Termux pkg installer with live progress"
while true; do
    cwd="$PWD"
    if [[ "$cwd" == "$HOME"* ]]; then
        prompt="~${cwd#$HOME}"
    else
        prompt="$cwd"
    fi
    printf "\$%s> " "$prompt"

    read -r line
    cmd=$(echo "$line" | awk '{print $1}')
    args=$(echo "$line" | cut -d' ' -f2-)

    case "$cmd" in
        exit) break ;;
        help) builtin_help ;;
        nyx)
            sub=$(echo "$args" | awk '{print $1}')
            pkgname=$(echo "$args" | awk '{print $2}')
            url=$(echo "$args" | awk '{print $3}')
            if [[ "$sub" == "install" && -n "$pkgname" ]]; then
                install_command "$pkgname"
            elif [[ "$sub" == "install-script" && -n "$pkgname" && -n "$url" ]]; then
                install_script "$pkgname" "$url"
            else
                echo "Usage: nyx install <package> OR nyx install-script <name> <url>"
            fi
            ;;
        *)
            if command -v "$cmd" >/dev/null 2>&1; then
                "$cmd" $args
            else
                echo "[*] Command $cmd not installed. Use: nyx install $cmd"
            fi
            ;;
    esac
done
