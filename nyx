#!/data/data/com.termux/files/usr/bin/bash
# =============================================
# NyxTerm: Hybrid Linux + Termux shell
# Supports automatic installs and public commands
# =============================================

PREFIX="$HOME/.nyxterm"
BIN="$PREFIX/bin"
mkdir -p "$BIN"

REPO_URL="https://github.com/luqmaan1007-collab/NyxCommands"  # approved commands

# ----------------------
# Helpers
# ----------------------
install_termux_pkg() {
    pkgname="$1"
    echo "[*] Installing Termux package $pkgname..."
    apt-get update -o Dpkg::Progress-Fancy=1
    apt-get install "$pkgname" -o Dpkg::Progress-Fancy=1
}

install_custom_command() {
    cmd="$1"
    deb_url="$2"
    tmp_deb="$PREFIX/$cmd.deb"
    echo "[*] Downloading $cmd from approved repo..."
    curl -L --progress-bar "$deb_url" -o "$tmp_deb"
    dpkg -i "$tmp_deb"
    rm "$tmp_deb"
    echo "[✓] $cmd installed!"
}

check_command() {
    cmd="$1"
    if command -v "$cmd" >/dev/null 2>&1; then
        return 0
    elif [ -x "$BIN/$cmd" ]; then
        return 0
    else
        return 1
    fi
}

builtin_help() {
    echo "NyxTerm commands:"
    echo "  nyx install <package>          - Install Termux package"
    echo "  nyx install-script <name> <url> - Install approved custom command"
    echo "  help                           - Show help"
    echo "  exit                           - Exit shell"
    echo "  Any installed command can be run directly"
}

# ----------------------
# Main shell loop
# ----------------------
echo "NyxTerm shell — hybrid Linux + Termux"
while true; do
    cwd="$PWD"
    prompt="$cwd"
    [[ "$cwd" == "$HOME"* ]] && prompt="~${cwd#$HOME}"
    printf "\$%s> " "$prompt"

    read -r line
    cmd=$(echo "$line" | awk '{print $1}')
    args=$(echo "$line" | cut -d' ' -f2-)

    case "$cmd" in
        exit) break ;;
        help) builtin_help ;;
        nyx)
            sub=$(echo "$args" | awk '{print $1}')
            pkgname=$(echo "$args" | awk '{print $2}')
            url=$(echo "$args" | awk '{print $3}')
            if [[ "$sub" == "install" && -n "$pkgname" ]]; then
                install_termux_pkg "$pkgname"
            elif [[ "$sub" == "install-script" && -n "$pkgname" && -n "$url" ]]; then
                install_custom_command "$pkgname" "$url"
            else
                echo "Usage: nyx install <package> OR nyx install-script <name> <url>"
            fi
            ;;
        *)
            if check_command "$cmd"; then
                "$cmd" $args
            else
                echo "[*] Command $cmd not installed. Use: nyx install $cmd"
            fi
            ;;
    esac
done
